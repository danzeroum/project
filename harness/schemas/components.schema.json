{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/components.schema.json",
  "title": "components.yaml — componentes técnicos ligados a capacidades",
  "type": "object",
  "required": ["schema_version", "metadata_version", "source_of_truth", "components"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": { "const": true },
        "generated_from": { "const": null }
      }
    },
    {
      "properties": {
        "source_of_truth": { "const": false },
        "generated_from": { "type": "string", "minLength": 1 }
      },
      "required": ["generated_from"]
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "metadata_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source_of_truth": { "type": "boolean" },
    "generated_from": { "type": ["string", "null"] },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "capability", "status", "source_paths", "tested_by", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "kind": { "enum": ["domain-module", "adapter", "port", "service", "ui-surface"] },
          "capability": { "type": "string", "pattern": "^CAP-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "status": { "enum": ["proposed", "planned", "implemented", "verified", "deprecated"] },
          "source_paths": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$" } },
          "exposes": { "type": "array", "items": { "type": "string" } },
          "tested_by": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
