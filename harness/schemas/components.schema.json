{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/components.schema.json",
  "title": "components.yaml — componentes técnicos ligados a capacidades",
  "type": "object",
  "required": [
    "schema_version",
    "metadata_version",
    "source_of_truth",
    "components",
    "exemptions"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": {
          "const": true
        },
        "generated_from": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "source_of_truth": {
          "const": false
        },
        "generated_from": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "generated_from"
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "metadata_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "source_of_truth": {
      "type": "boolean"
    },
    "generated_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "capability",
          "status",
          "source_paths",
          "tested_by",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "domain-module",
              "adapter",
              "port",
              "service",
              "ui-surface"
            ]
          },
          "capability": {
            "type": "string",
            "pattern": "^CAP-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "status": {
            "enum": [
              "proposed",
              "planned",
              "implemented",
              "verified",
              "deprecated"
            ]
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
            }
          },
          "exposes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tested_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3}$"
            }
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "exemptions": {
      "type": "array",
      "description": "Arquivos sob code_roots que deliberadamente NÃO pertencem a componente algum. Mesma mecânica de stages.yaml:ungoverned, incluindo a propriedade que a torna honesta: isenção que não casa arquivo nenhum é ela própria um achado, porque serve só para fazer a cobertura parecer fechada. Lista vazia é declaração válida — e é o que se espera de um alvo cujo código está inteiramente mapeado.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "justification"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    }
  }
}
