{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/capabilities.schema.json",
  "title": "capabilities.yaml — capacidades de negócio com rastreabilidade física",
  "type": "object",
  "required": ["schema_version", "metadata_version", "source_of_truth", "capabilities"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": { "const": true },
        "generated_from": { "const": null }
      }
    },
    {
      "properties": {
        "source_of_truth": { "const": false },
        "generated_from": { "type": "string", "minLength": 1 }
      },
      "required": ["generated_from"]
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "metadata_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source_of_truth": { "type": "boolean" },
    "generated_from": { "type": ["string", "null"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "owners", "risk_level", "source_paths", "test_paths"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "name": { "type": "string" },
          "status": {
            "enum": ["proposed", "planned", "implemented", "verified", "deprecated"],
            "description": "Maturidade. O fiscal semântico só exige código+teste existentes para implemented/verified."
          },
          "owners": {
            "type": "object",
            "required": ["business_owner", "technical_owner"],
            "additionalProperties": false,
            "properties": {
              "business_owner": { "type": "string" },
              "technical_owner": { "type": "string" }
            }
          },
          "risk_level": { "enum": ["low", "medium", "high", "critical"] },
          "source_paths": { "type": "array", "items": { "type": "string" } },
          "test_paths": { "type": "array", "items": { "type": "string" } },
          "business_rules": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "description": "Referências LÓGICAS a evidência. quality_reports pode apontar para dir gitignored — é referência, não garantia de arquivo versionado.",
            "additionalProperties": false,
            "properties": {
              "tests": { "type": "array", "items": { "type": "string" } },
              "architecture": { "type": "array", "items": { "type": "string" } },
              "quality_reports": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
