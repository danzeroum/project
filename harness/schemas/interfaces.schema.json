{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/interfaces.schema.json",
  "title": "architecture/interfaces.yaml — contratos de interface entre componentes",
  "description": "Cada interface tem um componente provedor e componentes consumidores. O fiscal cruza os símbolos expostos e as arestas com o grafo de componentes.",
  "type": "object",
  "required": [
    "schema_version",
    "metadata_version",
    "source_of_truth",
    "interfaces"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": {
          "const": true
        },
        "generated_from": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "source_of_truth": {
          "const": false
        },
        "generated_from": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "generated_from"
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "metadata_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "source_of_truth": {
      "type": "boolean"
    },
    "generated_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "provider",
          "consumers",
          "exposes",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IFC-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "python-api",
              "http",
              "event",
              "cli"
            ]
          },
          "provider": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
            }
          },
          "exposes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "proposed",
              "planned",
              "implemented",
              "verified",
              "deprecated"
            ]
          },
          "derived_from": {
            "type": "object",
            "description": "Proveniência da ingestão: de ONDE no alvo este item foi derivado, e em QUE commit. Sem o sha, 'este metadado descreve o alvo' vira afirmação sobre um alvo que já mudou — o mesmo modo de falha que target.lock resolve, uma camada acima. ci/validate_metadata.py::check_derived_from cobra que repo casa target.repo, que sha casa target.lock exatamente e que path existe no alvo materializado.",
            "required": [
              "repo",
              "sha",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Relativo à raiz do alvo, sem o prefixo workspace/target/."
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "description": "Âncora dentro do arquivo (título de seção, símbolo). Opcional: nem toda origem tem subdivisão."
              }
            }
          }
        }
      }
    }
  }
}
