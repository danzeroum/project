{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/interfaces.schema.json",
  "title": "architecture/interfaces.yaml — contratos de interface entre componentes",
  "description": "Cada interface tem um componente provedor e componentes consumidores. O fiscal cruza os símbolos expostos e as arestas com o grafo de componentes.",
  "type": "object",
  "required": ["schema_version", "metadata_version", "source_of_truth", "interfaces"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": { "const": true },
        "generated_from": { "const": null }
      }
    },
    {
      "properties": {
        "source_of_truth": { "const": false },
        "generated_from": { "type": "string", "minLength": 1 }
      },
      "required": ["generated_from"]
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "metadata_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source_of_truth": { "type": "boolean" },
    "generated_from": { "type": ["string", "null"] },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "provider", "consumers", "exposes", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^IFC-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "name": { "type": "string" },
          "kind": { "enum": ["python-api", "http", "event", "cli"] },
          "provider": { "type": "string", "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "consumers": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$" }
          },
          "exposes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "status": { "enum": ["proposed", "planned", "implemented", "verified", "deprecated"] }
        }
      }
    }
  }
}
