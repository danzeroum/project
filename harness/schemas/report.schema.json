{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/report.schema.json",
  "title": "Envelope do laudo",
  "description": "Envolve a procedência, o resultado e os achados. A procedência é obrigatória em qualquer comparação.",
  "type": "object",
  "allOf": [
    { "$ref": "provenance.schema.json" }
  ],
  "required": ["schema_version", "standard", "consumer_project", "execution", "result", "findings"],
  "properties": {
    "result": {
      "type": "string",
      "enum": ["ok", "findings", "suite_not_installed", "error"],
      "description": "ok = sem achados; findings = achados presentes; suite_not_installed = stub tolerante; error = falha."
    },
    "findings": {
      "type": "array",
      "description": "Achados já sanitizados pela suíte. Vazio quando result != findings.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "dimension"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "dimension": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Contagens agregadas por severidade/dimensão. Opcional.",
      "additionalProperties": true
    }
  }
}
