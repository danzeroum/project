{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/ui-surfaces.schema.json",
  "title": "ui-surfaces.yaml — superfícies de UI ligadas a capacidades",
  "description": "Critérios de experiência que precisam sobreviver a mudanças no código. Cada superfície aponta para uma capacidade (CAP-*).",
  "type": "object",
  "required": ["schema_version", "metadata_version", "source_of_truth", "ui_surfaces"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": { "const": true },
        "generated_from": { "const": null }
      }
    },
    {
      "properties": {
        "source_of_truth": { "const": false },
        "generated_from": { "type": "string", "minLength": 1 }
      },
      "required": ["generated_from"]
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "metadata_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source_of_truth": { "type": "boolean" },
    "generated_from": { "type": ["string", "null"] },
    "ui_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capability", "status", "routes", "primary_user_goal", "acceptance_criteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^UI-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "capability": { "type": "string", "pattern": "^CAP-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "status": { "enum": ["proposed", "planned", "implemented", "verified", "deprecated"] },
          "routes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "primary_user_goal": { "type": "string" },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "satisfies": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" } }
        }
      }
    }
  }
}
