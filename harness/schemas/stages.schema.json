{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danzeroum/project/harness/schemas/stages.schema.json",
  "title": "harness/stages.yaml — as etapas do projeto e seus fiscais",
  "description": "Índice das etapas, não uma segunda descrição do projeto. Referencia artefatos por CAMINHO e fiscais por caminho/símbolo; restatar um ID (CAP-, REQ-, CMP-...) aqui criaria uma segunda fonte de verdade, e o schema recusa estruturalmente.",
  "type": "object",
  "required": ["schema_version", "metadata_version", "source_of_truth", "stages", "ungoverned"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source_of_truth": { "const": true },
        "generated_from": { "const": null }
      }
    },
    {
      "properties": {
        "source_of_truth": { "const": false },
        "generated_from": { "type": "string", "minLength": 1 }
      },
      "required": ["generated_from"]
    }
  ],
  "$defs": {
    "artifact": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(CAP|REQ|CMP|IFC|RULE|UI|MET|ADR|RISK)-[A-Z0-9]" },
      "description": "Caminho ou glob relativo à raiz. Nunca um ID — IDs moram no arquivo dono."
    },
    "enforcer": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["ci_script", "workflow_step", "schema", "external_standard", "none"] },
        "ref": { "type": "string", "minLength": 1 },
        "symbol": {
          "type": "string",
          "description": "Função/classe que precisa existir no ci_script (verificada por AST). Renomeá-la quebra o fiscal — que é o comportamento desejado."
        },
        "step": { "type": "string", "description": "Nome literal do passo, para kind workflow_step." },
        "standard": { "type": "string" },
        "version_source": { "const": "requirements-qa.txt" },
        "justification": { "type": "string", "minLength": 40 }
      },
      "allOf": [
        {
          "comment": "Símbolo só faz sentido em script local.",
          "if": { "properties": { "kind": { "const": "ci_script" } }, "required": ["kind"] },
          "then": { "not": { "required": ["step", "standard", "justification"] } }
        },
        {
          "comment": "workflow_step exige o nome do passo — âncora estável, ao contrário de regex posicional.",
          "if": { "properties": { "kind": { "const": "workflow_step" } }, "required": ["kind"] },
          "then": { "required": ["step"] }
        },
        {
          "comment": "Idem risk-register: um controle no padrão externo ancora a versão localmente.",
          "if": { "properties": { "kind": { "const": "external_standard" } }, "required": ["kind"] },
          "then": { "required": ["standard", "version_source"] }
        },
        {
          "comment": "Declarar que uma etapa NÃO tem fiscal é permitido — mas exige justificativa e vira achado no laudo. Silêncio, não.",
          "if": { "properties": { "kind": { "const": "none" } }, "required": ["kind"] },
          "then": { "required": ["justification"] }
        }
      ]
    }
  },
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "metadata_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "source_of_truth": { "type": "boolean" },
    "generated_from": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "name", "artifacts", "enforced_by", "privacy_lens"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^STAGE-[A-Z0-9]+(-[A-Z0-9]+)*$" },
          "order": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
          "enforced_by": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/enforcer" } },
          "privacy_lens": {
            "type": "object",
            "description": "A lente de LGPD desta etapa. scan:true põe os artefatos na superfície varrida por ci/audit_lgpd.py — a superfície é declarada uma vez, nunca hard-coded no fiscal.",
            "required": ["scan", "question"],
            "additionalProperties": false,
            "properties": {
              "scan": { "type": "boolean" },
              "question": { "type": "string", "minLength": 20 }
            }
          }
        }
      }
    },
    "ungoverned": {
      "type": "array",
      "description": "Arquivos deliberadamente fora de qualquer etapa. A isenção é declarada com motivo, nunca tácita — e uma isenção que não casa nada é isenção morta.",
      "items": {
        "type": "object",
        "required": ["path", "justification"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/$defs/artifact" },
          "justification": { "type": "string", "minLength": 40 }
        }
      }
    }
  }
}
